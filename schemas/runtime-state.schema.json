{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Resivore/Mynx-Flavoured-Workbench/schemas/runtime-state.schema.json",
  "title": "Mynx Flavoured Workbench two-slot runtime state",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "activation", "revision", "updated_at", "accepted_baseline", "slots"],
  "properties": {
    "$schema": { "const": "../../schemas/runtime-state.schema.json" },
    "schema_version": { "const": 1 },
    "activation": { "enum": ["GATED", "ACTIVE"] },
    "revision": { "type": "integer", "minimum": 0 },
    "updated_at": { "type": "string", "format": "date-time" },
    "accepted_baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "members"],
      "properties": {
        "revision": { "type": "integer", "minimum": 0 },
        "members": { "type": "array", "items": { "$ref": "#/$defs/acceptedMember" } }
      }
    },
    "slots": {
      "type": "object",
      "additionalProperties": false,
      "required": ["A", "B"],
      "properties": {
        "A": { "$ref": "#/$defs/nullableSlot" },
        "B": { "$ref": "#/$defs/nullableSlot" }
      }
    }
  },
  "$defs": {
    "uuid": { "type": "string", "format": "uuid" },
    "projectId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "nonblank": { "type": "string", "minLength": 1, "pattern": "^\\S(?:.*\\S)?$" },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "kind", "filename", "sha256", "ownership_keys"],
      "properties": {
        "artifact_id": { "$ref": "#/$defs/uuid" },
        "kind": { "enum": ["MOD", "RESOURCE_PACK"] },
        "filename": {
          "type": "string",
          "allOf": [
            { "pattern": "^[^<>:\"/\\\\|?*\\u0000-\\u001f]+$" },
            { "pattern": "[^. ]$" },
            { "not": { "pattern": "^(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:\\.|$)" } }
          ]
        },
        "sha256": { "$ref": "#/$defs/sha256" },
        "ownership_keys": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$" }
        }
      }
    },
    "unit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deployment_id", "project_uuid", "project_id", "version", "source_commit", "artifacts"],
      "properties": {
        "deployment_id": { "$ref": "#/$defs/uuid" },
        "project_uuid": { "$ref": "#/$defs/uuid" },
        "project_id": { "$ref": "#/$defs/projectId" },
        "version": { "$ref": "#/$defs/nonblank" },
        "source_commit": { "$ref": "#/$defs/commit" },
        "artifacts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/artifact" } }
      }
    },
    "acceptedMember": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit", "accepted_at"],
      "properties": {
        "unit": { "$ref": "#/$defs/unit" },
        "accepted_at": { "type": "string", "format": "date-time" }
      }
    },
    "slot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit", "replaces_accepted_deployment_id", "deployment", "runtime_result"],
      "properties": {
        "unit": { "$ref": "#/$defs/unit" },
        "replaces_accepted_deployment_id": {
          "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/uuid" }]
        },
        "deployment": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "deployed_at", "ready_verified_at"],
          "properties": {
            "state": { "enum": ["NOT_DEPLOYED", "DEPLOYED", "READY_TO_TEST_VERIFIED"] },
            "deployed_at": { "anyOf": [{ "type": "null" }, { "type": "string", "format": "date-time" }] },
            "ready_verified_at": { "anyOf": [{ "type": "null" }, { "type": "string", "format": "date-time" }] }
          }
        },
        "runtime_result": {
          "type": "object",
          "additionalProperties": false,
          "required": ["classification", "recorded_at"],
          "properties": {
            "classification": { "enum": ["UNTESTED", "PASS", "FAIL", "INCONCLUSIVE"] },
            "recorded_at": { "anyOf": [{ "type": "null" }, { "type": "string", "format": "date-time" }] }
          }
        }
      }
    },
    "nullableSlot": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/slot" }] }
  }
}
