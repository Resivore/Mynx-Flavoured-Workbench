{
  "schemaVersion": 1,
  "id": "wearable_lanterns",
  "version": "${version}",
  "name": "Wearable Lanterns",
  "description": "Adds a dedicated native Trinkets lantern slot and resource-aware worn lantern rendering.",
  "authors": ["Resivore"],
  "license": "All-Rights-Reserved",
  "environment": "*",
  "entrypoints": {
    "main": [
      "dev.resivore.wearablelanterns.WearableLanterns"
    ]
  },
  "mixins": [
    {
      "config": "wearable_lanterns.iris.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.19.3",
    "fabric-api": ">=0.157.0",
    "minecraft": "26.2",
    "java": ">=25",
    "trinkets_updated": ">=4.1.0-beta.3"
  },
  "suggests": {
    "lambdynlights": "*",
    "iris": ">=1.11.2"
  },
  "custom": {
    "workbench:classification": "GENERATED / UNTESTED",
    "workbench:deployment": "NOT DEPLOYED",
    "runtime_dependency_policy": {
      "contract": "CAPABILITY_OR_PROVIDER",
      "exceptions": []
    }
  }
}
