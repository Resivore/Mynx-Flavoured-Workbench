{
  "schemaVersion": 1,
  "id": "map_marker_extension",
  "version": "${version}",
  "name": "Map Marker Extension",
  "description": "Gives known exploration maps distinct native marker identities shared by Minecraft, Xaero, and other map-decoration consumers.",
  "authors": ["Resivore compatibility workbench"],
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": [
      "dev.resivore.mapmarkerextension.MapMarkerExtension"
    ],
    "client": [
      "dev.resivore.mapmarkerextension.MapMarkerExtensionClient"
    ]
  },
  "mixins": [
    "map_marker_extension.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.3",
    "fabric-api": ">=0.157.0",
    "minecraft": ">=26.2 <26.3"
  },
  "suggests": {
    "xaerominimap": "26.4.2",
    "xaeroworldmap": "1.44.2"
  }
}
