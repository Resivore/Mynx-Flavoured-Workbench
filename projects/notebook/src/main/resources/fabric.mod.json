{
  "schemaVersion": 1,
  "id": "notebook",
  "version": "${version}",
  "name": "Notebook",
  "description": "A lightweight, externally editable personal notebook with a Minecraft-native two-page interface.",
  "authors": ["Resivore"],
  "license": "All-Rights-Reserved",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.resivore.notebook.NotebookClient"
    ]
  },
  "mixins": [
    "notebook.client.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.3",
    "fabric-api": "0.157.0+26.2",
    "minecraft": "=26.2",
    "java": ">=25"
  },
  "custom": {
    "workbench:classification": "GENERATED / STATICALLY VALIDATED / RUNTIME UNTESTED",
    "workbench:deployment": "NOT DEPLOYED"
  }
}
