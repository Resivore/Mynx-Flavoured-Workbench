{
  "schemaVersion": 1,
  "id": "stacksarestacks_container_fixes",
  "version": "${version}",
  "name": "Stacks Are Stacks Container Fixes",
  "description": "Keeps Stacks Are Stacks effective maximums visible to Minecraft 26.2 client container and tooltip paths.",
  "authors": ["Resivore"],
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.resivore.stacksarestackscontainerfixes.StacksAreStacksContainerFixesClient"
    ]
  },
  "mixins": [
    "stacksarestacks_container_fixes.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.3",
    "fabric-api": "*",
    "minecraft": "=26.2",
    "java": ">=25",
    "stacksarestacks": "=2.1.2-1.26.2"
  },
  "custom": {
    "workbench:classification": "GENERATED / UNTESTED",
    "workbench:deployment": "NOT DEPLOYED"
  }
}
