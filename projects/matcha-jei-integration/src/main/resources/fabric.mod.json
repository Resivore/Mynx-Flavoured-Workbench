{
  "schemaVersion": 1,
  "id": "matcha_jei_integration",
  "version": "${version}",
  "name": "Matcha Flavoured JEI Integration",
  "description": "Exposes Matcha component recipes, villager trades, and loot acquisition sources to JEI while unlocking loaded Matcha recipes in the vanilla recipe book.",
  "authors": ["Resivore"],
  "license": "All-Rights-Reserved",
  "environment": "*",
  "entrypoints": {
    "main": ["dev.resivore.matchajei.MatchaJeiIntegration"],
    "client": ["dev.resivore.matchajei.client.MatchaJeiClient"],
    "jei_mod_plugin": ["dev.resivore.matchajei.client.MatchaJeiPlugin"]
  },
  "depends": {
    "fabricloader": ">=0.19.0",
    "fabric-api": ">=0.157.0+26.2",
    "minecraft": "26.2",
    "java": ">=25"
  },
  "recommends": {
    "jei": "30.18.0.144"
  }
}
