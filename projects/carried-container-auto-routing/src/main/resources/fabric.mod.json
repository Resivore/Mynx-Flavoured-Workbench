{
  "schemaVersion": 1,
  "id": "carried_container_auto_routing",
  "version": "${version}",
  "name": "Carried Container Auto-Routing",
  "description": "Routes newly acquired matching items into carried containers and extends Survival Pick Block to unlocked carried shulkers.",
  "environment": "*",
  "entrypoints": {
    "main": ["dev.resivore.carriedrouting.CarriedContainerAutoRouting"],
    "client": ["dev.resivore.carriedrouting.client.CarriedContainerAutoRoutingClient"]
  },
  "mixins": ["carried_container_auto_routing.mixins.json"],
  "depends": { "fabricloader": ">=0.19.3", "minecraft": "26.2", "java": ">=25", "fabric-api": "*" },
  "suggests": { "container_slot_reservations": "*" }
}
