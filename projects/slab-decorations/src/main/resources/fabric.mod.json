  "depends": {
    "fabricloader": ">=0.19.3",
    "fabric-api": ">=0.157.0",
    "minecraft": "=26.2",
    "java": ">=25",
    "more_slabs_stairs_and_walls": "=4.2.0+26.2-port-canary41-pale-recipe-fix"
  },
  "suggests": {
    "clutternomore": "=2.0.7+26.2",
    "cnm_terrain_slabs_compat": "=0.5.46-nibaru-cnm-canary1.36-pale-coverage"
