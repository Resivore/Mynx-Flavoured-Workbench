{
  "schemaVersion": 1,
  "id": "slab_decorations",
  "version": "${version}",
  "name": "Workbench Slab Decorations",
  "description": "Canonical-parent foliage parity and bounded substrate bonemeal for BGE native horizontal slabs.",
  "authors": ["Resivore"],
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "client": [
      "dev.resivore.slabdecorations.client.SlabDecorationsClient"
    ]
  },
  "mixins": [
    "slab_decorations.mixins.json",
    "slab_decorations.client.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.3",
    "fabric-api": ">=0.157.0",
    "minecraft": "=26.2",
    "java": ">=25",
    "more_slabs_stairs_and_walls": "*"
  },
  "suggests": {
    "clutternomore": "*",
    "cnm_terrain_slabs_compat": "*"
  },
  "custom": {
    "workbench:classification": "GENERATED / STATICALLY VALIDATED / RUNTIME UNTESTED",
    "workbench:deployment": "NOT DEPLOYED",
    "workbench:runtime-slot-owner": "Slab Decorations Foliage — Canary 4"
  }
}
