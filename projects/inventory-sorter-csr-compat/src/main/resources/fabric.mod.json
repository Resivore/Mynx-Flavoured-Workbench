{
  "schemaVersion": 1,
  "id": "inventory_sorter_csr_compat",
  "version": "${version}",
  "name": "Inventory Sorter CSR Compatibility",
  "description": "Keeps CSR-reserved slots fixed while sorting portable containers as outer ItemStacks.",
  "authors": ["Resivore"],
  "license": "MIT",
  "environment": "*",
  "mixins": [
    "inventory_sorter_csr_compat.mixins.json",
    "inventory_sorter_csr_compat.client.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "=26.2",
    "java": ">=25",
    "fabric-api": ">=0.157.0",
    "inventorysorter": "*",
    "container_slot_reservations": "*"
  },
  "custom": {
    "runtime_dependency_policy": {
      "contract": "CAPABILITY_OR_PROVIDER",
      "exceptions": []
    },
    "workbench:classification": "GENERATED / STATICALLY VALIDATED / RUNTIME UNTESTED",
    "workbench:deployment": "NOT DEPLOYED",
    "workbench:runtime-slot-owner": "Inventory Sorter CSR Compatibility - Canary 2"
  }
}
